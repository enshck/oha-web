{
  "name": "oha-web",
  "private": true,
  "version": "1.00",
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "start": "tsc && VITE_APP_ENV=dev vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"**/*.+(ts|tsx)\" --fix",
    "prettier": "prettier --write \"**/*.+(ts|tsx)\"",
    "chakra:typegen": "npx @chakra-ui/cli typegen ./src/assets/theme/theme.ts",
    "chakra:snippet": "npx @chakra-ui/cli snippet add",
    "chakra:snippets-list": "npx @chakra-ui/cli snippet list"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.28.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-router": "^1.133.27",
    "@tanstack/react-router-devtools": "^1.133.27",
    "axios": "^1.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.28.0",
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "lefthook": "^2.0.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "main": "index.js",
  "packageManager": "yarn@4.9.4"
}
